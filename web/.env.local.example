# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name # Set by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud # Set by `npx convex dev`

# Stripe (for payments)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email service (optional - for waitlist notifications)
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@pompyboard.com

# Discord webhook (optional - for announcements)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=...
